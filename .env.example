# Baza de date (Vercel + Neon le setează automat)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Secret pentru sesiuni (opțional; implicit derivat din DATABASE_URL). Generați cu: openssl rand -base64 32
AUTH_SECRET=
# Emailurile administratorilor, separate prin virgulă. Ei își setează parola la /configurare.
ADMIN_EMAILS=
